<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoGOQRCodesGenerator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PoGOQRCodesGenerator"
    Shell.FlyoutBehavior="Disabled"
    Title="PoGOQRCodesGenerator">

    <TabBar>
        <ShellContent Title="QR images" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        <ShellContent Title="Print cards" ContentTemplate="{DataTemplate local:CardsPage}" Route="CardsPage" />
    </TabBar>

</Shell>
