<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoGOQRCodesGenerator.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="PoGO QR Codes Generator">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <Label Text="Promo codes (one per line):"
                       FontAttributes="Bold" />

                <Editor x:Name="CodesEditor"
                        AutoSize="TextChanges"
                        HeightRequest="150"
                        Placeholder="3JW4CDS5L4DBK&#10;AB4C1234EF6H" />

                <Label Text="Base URL template:"
                       FontAttributes="Bold" />

                <Entry x:Name="BaseUrlEntry"
                       Text="https://store.pokemongo.com/offer-redemption?passcode={code}" />

                <Button Text="Save all QR"
                        Clicked="OnSaveQrClicked" />

                <Label x:Name="StatusLabel"
                       Text=""
                       TextColor="Green"
                       Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>